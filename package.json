  "description": "JN Ceylon Products ERP System — A modern quote-to-cash platform for export businesses",
  "main": "server/index.js",
  "author": "JN Ceylon",
  "license": "MIT",
  "homepage": "https://jn-ceylon.onrender.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/perera99-msd/JN-CEYLON.git"
  },
  "bugs": {
    "url": "https://github.com/perera99-msd/JN-CEYLON/issues"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "erp",
    "quotation",
    "invoice",
    "payment",
    "statement",
