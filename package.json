{
  "name": "jn-ceylon-erp",
  "version": "1.0.0",
  "description": "JN Ceylon Products ERP System",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "server": "nodemon server/index.js",
    "client": "npm run dev --prefix client",
