    "express": "^4.19.2",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "mongoose": "^8.4.1"
  },
  "devDependencies": {
