# Server
NODE_ENV=development
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/jn_ceylon_erp

# Session and browser security
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-characters
CORS_ORIGINS=http://localhost:5173
COOKIE_SAME_SITE=lax

# Initial administrator bootstrap
# Used only when the configured username does not already exist.
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-characters
ADMIN_FULL_NAME=JN Ceylon Administrator
